{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pulso-infra/release/deploy-manifest.schema.json",
  "title": "Pulso joint deploy manifest",
  "description": "Plan 17.3.9 / SR-07. Structural contract only; cross-field rules M-01..M-10 live in validate_manifest.py. `signature` stays dependency_blocked: the manifest is pinned by its digest recorded in approvals[].",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "environment", "engine", "agent_core", "contracts", "compat",
    "assets", "exporter", "console", "sandbox", "runtime_config", "infra",
    "approvals", "smoke", "rollback", "signature"
  ],
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "git_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "schema_digests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime", "eval"],
      "properties": {
        "runtime": { "$ref": "#/$defs/digest" },
        "eval": { "$ref": "#/$defs/digest" }
      }
    }
  },
  "properties": {
    "schema_version": { "const": "1" },
    "environment": { "enum": ["staging", "prod"] },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image_digest", "git_sha", "migrations_head", "migration_class",
        "expected_contracts_version", "expected_pin_manifest_digest"
      ],
      "properties": {
        "image_digest": { "$ref": "#/$defs/digest" },
        "git_sha": { "$ref": "#/$defs/git_sha" },
        "migrations_head": { "type": "string", "minLength": 1 },
        "migration_class": { "enum": ["none", "expand", "contract"] },
        "expected_contracts_version": { "type": "string", "minLength": 1 },
        "expected_pin_manifest_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "agent_core": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image_digest", "image_tag", "git_sha", "contracts_version",
        "schema_digest", "pulso_package_sha"
      ],
      "properties": {
        "image_digest": { "$ref": "#/$defs/digest" },
        "image_tag": { "type": "string", "pattern": "^[0-9a-f]{7}-[0-9a-f]{7}$" },
        "git_sha": { "$ref": "#/$defs/git_sha" },
        "contracts_version": { "type": "string", "minLength": 1 },
        "schema_digest": { "$ref": "#/$defs/schema_digests" },
        "pulso_package_sha": { "$ref": "#/$defs/git_sha" }
      }
    },
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pin_manifest_digest"],
      "properties": { "pin_manifest_digest": { "$ref": "#/$defs/digest" } }
    },
    "compat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "n_minus_1_image_tested", "strategy"],
      "properties": {
        "kind": { "enum": ["unchanged", "expand", "contract"] },
        "n_minus_1_image_tested": { "type": "boolean" },
        "strategy": { "type": ["string", "null"] }
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_digest", "expected_state_digest", "release_ids"],
      "properties": {
        "manifest_digest": { "$ref": "#/$defs/digest" },
        "expected_state_digest": { "$ref": "#/$defs/digest" },
        "release_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "exporter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image_digest"],
      "properties": { "image_digest": { "$ref": "#/$defs/digest" } }
    },
    "console": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image_digest", "reason"],
      "properties": {
        "image_digest": { "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
        "reason": { "type": ["string", "null"] }
      }
    },
    "sandbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image_digest", "reason"],
      "properties": {
        "image_digest": { "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
        "reason": { "type": ["string", "null"] }
      }
    },
    "runtime_config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "digest"],
      "properties": {
        "ref": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "infra": {
      "type": "object",
      "additionalProperties": false,
      "required": ["git_sha", "tfvars_digest", "plan_digest"],
      "properties": {
        "git_sha": { "$ref": "#/$defs/git_sha" },
        "tfvars_digest": { "$ref": "#/$defs/digest" },
        "plan_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "approvals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["approver", "role", "approved_at", "manifest_digest"],
        "properties": {
          "approver": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 },
          "approved_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z$" },
          "manifest_digest": { "$ref": "#/$defs/digest" }
        }
      }
    },
    "smoke": {
      "type": "object",
      "additionalProperties": false,
      "required": ["suite", "target", "doubles", "result"],
      "properties": {
        "suite": { "type": "string", "minLength": 1 },
        "target": { "enum": ["real_aws", "local", "localstack", "none"] },
        "doubles": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "result": { "enum": ["ok", "failed", "not_run"] }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["previous_manifest_digest", "previous_schema_digest"],
      "properties": {
        "previous_manifest_digest": { "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
        "previous_schema_digest": { "$ref": "#/$defs/schema_digests" }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": { "status": { "const": "dependency_blocked" } }
    }
  }
}
