{
	auto_https off
	admin off
}

# ORIGIN_VERIFY is rendered into common.env from the secret key COMMON__ORIGIN_VERIFY (the host refuses to start
# without it). CloudFront sends it as X-Origin-Verify; everything else is rejected. `route` keeps this order literally.
:8080 {
	route {
		@healthz path /healthz
		respond @healthz "ok" 200

		@unverified not header X-Origin-Verify {$ORIGIN_VERIFY}
		respond @unverified "forbidden" 403

		@internal path /internal /internal/* /pulso/internal /pulso/internal/*
		respond @internal "not found" 404

		@pulso path /pulso/*
		uri @pulso strip_prefix /pulso
		reverse_proxy @pulso pulso:8080

		respond "not found" 404
	}
}
