# Example only. On the host /srv/stack/.env is rendered by Terraform (images, bucket) - do not hand-edit.
# NEVER put secrets here. Secrets live in ONE Secrets Manager secret (see README).
CORE_IMAGE=ACCOUNT.dkr.ecr.REGION.amazonaws.com/agent-core@sha256:<64 hex>
GATEWAY_IMAGE=ACCOUNT.dkr.ecr.REGION.amazonaws.com/llm-gateway@sha256:<64 hex>
SUPPORT_API_IMAGE=ACCOUNT.dkr.ecr.REGION.amazonaws.com/support-api@sha256:<64 hex>
SUPPORT_WEB_IMAGE=ACCOUNT.dkr.ecr.REGION.amazonaws.com/support-web@sha256:<64 hex>
PULSO_IMAGE=ACCOUNT.dkr.ecr.REGION.amazonaws.com/pulso@sha256:<64 hex>
PROXY_IMAGE=ACCOUNT.dkr.ecr.REGION.amazonaws.com/caddy@sha256:<64 hex>
BUCKET_NAME=your-single-bucket
CORE_BLOB_PREFIX=core/blobs/
PULSO_STORAGE_PREFIX=engine/
