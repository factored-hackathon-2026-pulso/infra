{
	auto_https off
	admin off
}

# ORIGIN_VERIFY is rendered into common.env from the secret key COMMON__ORIGIN_VERIFY (the host refuses to start
# without it). CloudFront sends it as X-Origin-Verify; everything else (another CloudFront distribution, a scanner on
# the public IP) is rejected. `route` keeps this order literally: nothing is proxied before the check.
:80 {
	route {
		@healthz path /healthz
		respond @healthz "ok" 200

		@unverified not header X-Origin-Verify {$ORIGIN_VERIFY}
		respond @unverified "forbidden" 403

		# Core and gateway /internal routes never leave the docker network; the platform's own /api/v1/internal/*
		# (grant_active) is for agent-core over the VPC on :8000, never for CloudFront.
		@internal path /internal /internal/* /api/internal /api/internal/* /api/v1/internal /api/v1/internal/*
		respond @internal "not found" 404

		# REST and WebSocket (/api/v1/ws) share this upstream; Caddy upgrades WebSockets itself.
		reverse_proxy /api/* support-platform-api:8000
		reverse_proxy support-platform-web:80
	}
}
