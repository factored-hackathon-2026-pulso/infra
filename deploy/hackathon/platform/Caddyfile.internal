{
	auto_https off
	admin off
}

# agent-core's grant_active check (AGENTCORE_GRANTS_URL, bearer AGENTCORE_GRANTS_TOKEN = CC_INTERNAL_SERVICE_TOKEN). Nothing
# else of the platform is reachable here; the security group admits only the core host on this port.
:8081 {
	route {
		@healthz path /healthz
		respond @healthz "ok" 200

		@grants path /api/v1/internal/grants/*
		reverse_proxy @grants support-platform-api:8000

		respond "not found" 404
	}
}
