# Copy to prod.tfvars (ignored by Git) and fill the image digests. `scripts/aws-prod.ps1 images` writes them for you.
# No secrets belong here: secret values live only in Secrets Manager (docs/secrets-keys.md).
# Everything else (region us-east-1, environment prod, name_prefix pulso-prod, registry URL, who may upload/load)
# has a working default.

# Required. Format: registry host, repo path, then @sha256: and the 64-hex digest, repos created by terraform/bootstrap (prefix "pulso-prod/").
# Replace <registry> with <account id>.dkr.ecr.us-east-1.amazonaws.com and each digest with the pushed one.
images = {
  core = {
    core    = "<registry>/pulso-prod/core-runtime@sha256:REPLACE_WITH_64_HEX_DIGEST"
    gateway = "<registry>/pulso-prod/llm-gateway@sha256:REPLACE_WITH_64_HEX_DIGEST"
  }
  platform = {
    support_api = "<registry>/pulso-prod/support-platform-api@sha256:REPLACE_WITH_64_HEX_DIGEST"
    support_web = "<registry>/pulso-prod/support-platform-web@sha256:REPLACE_WITH_64_HEX_DIGEST"
    proxy       = "<registry>/pulso-prod/caddy@sha256:REPLACE_WITH_64_HEX_DIGEST"
  }
  engine = {
    pulso = "<registry>/pulso-prod/pulso-engine@sha256:REPLACE_WITH_64_HEX_DIGEST"
    proxy = "<registry>/pulso-prod/caddy@sha256:REPLACE_WITH_64_HEX_DIGEST"
  }
}

# Profile. free_plan (default for now) is for an AWS Free Plan account: core host m7i-flex.large with Postgres in a
# container, no NAT gateway, CloudFront with public origins, WAF off, CodeBuild SMALL. prod is the previous design
# (RDS, NAT, VPC origins, WAF). See docs/costs.md and docs/decisions.md (ADR 0008).
# profile       = "free_plan"   # or "prod"
# database_mode = "container"   # container | rds (null = derived from the profile)
# edge_enabled  = true          # false: come up without CloudFront (staged apply)
# images.core may carry an optional digest-pinned ECR mirror: postgres = "<registry>/pulso-prod/postgres@sha256:..."

# Agent services (docs/agent-services.md): agent-core serve (core:8001) and tool-service for support-platform. Turn on
# only when both images are built; with the flag on, plan requires the two digests below.
# agent_services_enabled = true
#   and in images.core:
#     agent = "<registry>/pulso-prod/agent-core-serve@sha256:REPLACE_WITH_64_HEX_DIGEST"
#     tools = "<registry>/pulso-prod/tool-service@sha256:REPLACE_WITH_64_HEX_DIGEST"
# agent_serve_args: OPTIONAL extra serve arguments, empty by default (the seven real pieces are serve's defaults); never testing.* doubles.
# images.core.core (the old core-bridge image) is no longer needed with agent services on. docs/agent-core-serve.md.
# agent_serve_agents = "recepcion,disputas,consultas,copiloto-asesor"   # AGENTCORE_SERVE_AGENTS
# Calibration and classifier artifacts: upload to s3://<bucket>/core/artifacts/{calibrations,classifiers}/ (docs/agent-services.md).

# Improvement loop on the engine host (docs/engine-loop.md): `pulso loop` as a systemd one-shot. Needs agent_services_enabled and the
# ENGPROD engine image (python3 and the regression scripts inside).
# engine_loop_enabled      = true
# engine_loop_interval     = "6h"
# engine_loop_cells_source = "bank"       # bank | e0 | synthetic (synthetic only with engine_loop_profile = "demo")
# engine_loop_profile      = "standard"
#
# OTLP forwarder sidecars (docs/otlp-forwarder.md, off by default). Needs the same digest in images.core.forwarder and
# images.engine.forwarder, and the secret keys LANGFUSE__LANGFUSE_PUBLIC_KEY and _SECRET_KEY.
# otlp_forwarder_enabled = true
# otlp_trace_content     = false            # true exports prompts and responses
# langfuse_base_url      = "https://us.cloud.langfuse.com"
#
# Engine key rotation (docs/agent-core-serve.md section 7): add, then mint, then retire. Each step needs a secret merge afterwards.
# engine_extra_key_suffixes = ["hk2"]
# engine_active_key_suffix  = "hk2"
# engine_retire_base_key    = true
#
# Optional levers (defaults shown).
# enable_waf           = false   # about 8 USD per month; default false in free_plan, true in prod
# enabled              = { core = true, platform = true, engine = true }   # per-host kill switch
# instance_types       = { core = "m7i-flex.large", platform = "t3.small", engine = "t3.small" }   # free_plan; prod: t3.small x3
# data_volume_size_gb  = { core = 20, platform = 20, engine = 40 }
# protect_data_volume  = true
# engine_host_can_load = false   # default; true gives the engine host role PII access directly
# auto_loader_enabled  = true    # automatic landing -> lake loader (dedicated role, systemd timer; docs/auto-loader.md); needs images.engine.pipeline
# platform_database_enabled = true   # platform + tool-service databases on the shared Postgres, engine -> platform path (needs agent_services_enabled)
# uploader_principal_arns    = []   # empty = the account's IAM users and root may upload to landing/
# break_glass_principal_arns = []
# loader_role_arns           = []   # extra loader roles; auto_loader_enabled adds its own
