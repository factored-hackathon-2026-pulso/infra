#!/bin/bash
# Runs before `docker compose up`. Never prints secret values.
set -euo pipefail
umask 077
REGION="${region}"
BUCKET="${bucket}"
PREFIX="${bundle_prefix}"
SECRET_ARN="${secret_arn}"
SSM_PREFIX="${ssm_prefix}/${workload}"
SERVICES="${services}"

aws s3 sync "s3://$BUCKET/$PREFIX" /srv/stack/ --region "$REGION" --only-show-errors
aws ecr get-login-password --region "$REGION" | docker login --username AWS --password-stdin "${registry}" >/dev/null

# Image digests: $SSM_PREFIX/images/<key> -> <KEY>_IMAGE=<repo and digest> in .env. Terraform only seeds these
# parameters; deploy-stack.sh (aws-prod.ps1 deploy) changes them without replacing the instance.
IMG_TMP="$(mktemp /srv/stack/.env.XXXXXX)"
{ grep -v -E '^[A-Z0-9_]+_IMAGE=' /srv/stack/.env || true; } > "$IMG_TMP"
aws ssm get-parameters-by-path --path "$SSM_PREFIX/images" --region "$REGION"   --query 'Parameters[].[Name,Value]' --output text |
  while IFS=$'	' read -r name value; do
    [ -n "$name" ] && printf '%s_IMAGE=%s
' "$(basename "$name" | tr 'a-z' 'A-Z')" "$value" >> "$IMG_TMP"
  done
grep -q '_IMAGE=' "$IMG_TMP" || { echo "no image parameters under $SSM_PREFIX/images" >&2; exit 1; }
chmod 644 "$IMG_TMP"
mv "$IMG_TMP" /srv/stack/.env

mkdir -p /srv/data/support /srv/data/pulso /srv/data/exporter /srv/data/keys
# The engine image runs as uid 10001 and keeps its work and store dirs on this bind mount (a root-owned mount makes `pulso run` exit).
chown 10001:10001 /srv/data/exporter /srv/data/pulso
chmod 700 /srv/data/keys

install -d -m 700 /run/pulso/env
for s in $SERVICES; do : > "/run/pulso/env/$s.env"; done

# Non-secret config: $SSM_PREFIX/<svc>/<VAR>
for s in $SERVICES; do
  aws ssm get-parameters-by-path --path "$SSM_PREFIX/$s" --recursive --region "$REGION" \
    --query 'Parameters[].[Name,Value]' --output text 2>/dev/null |
    while IFS=$'\t' read -r name value; do
      [ -n "$name" ] && printf '%s=%s\n' "$(basename "$name")" "$value" >> "/run/pulso/env/$s.env"
    done
done

# Secrets: ONE secret, JSON keys "<SERVICE>__<VAR>" -> /run/pulso/env/<service>.env
aws secretsmanager get-secret-value --secret-id "$SECRET_ARN" --region "$REGION" \
  --query SecretString --output text |
  jq -r 'to_entries[] | select(.key | test("^(${svc_regex})__")) |
         [(.key | split("__")[0] | ascii_downcase), (.key | sub("^[A-Z]+__";"")), (.value | tostring)] | @tsv' |
  while IFS=$'\t' read -r svc var val; do
    printf '%s=%s\n' "$var" "$val" >> "/run/pulso/env/$svc.env"
  done
chmod 600 /run/pulso/env/*.env

# Files: secret keys "FILES__<SERVICE>__<NAME>" -> /run/pulso/files/<service>/<NAME> (tmpfs, 0400, uid 10001 = the app
# user of the images). For values that are files to the services (key sets, grants); never rendered as env lines.
rm -rf /run/pulso/files
install -d -m 755 /run/pulso/files
for s in $SERVICES; do install -d -m 500 -o 10001 -g 10001 "/run/pulso/files/$s"; done
SECRET_JSON="$(aws secretsmanager get-secret-value --secret-id "$SECRET_ARN" --region "$REGION" --query SecretString --output text)"
printf '%s' "$SECRET_JSON" | jq -r 'keys[] | select(test("^FILES__(${svc_regex})__[A-Z0-9_]+$"))' |
  while read -r key; do
    svc="$(printf '%s' "$key" | cut -d_ -f3 | tr 'A-Z' 'a-z')"
    name="$${key#FILES__*__}"
    out="/run/pulso/files/$svc/$name"
    printf '%s' "$SECRET_JSON" | jq -j --arg k "$key" '.[$k] | tostring' > "$out"
    chown 10001:10001 "$out"; chmod 400 "$out"
  done
unset SECRET_JSON
%{ if sync_artifacts ~}
# agent-core serve: calibration and classifier artifacts (data team output) and the registry seed, uploaded by an admin
# to s3://<bucket>/core/artifacts/{calibrations,classifiers,registry-seed}/. Mirrored with --delete so a withdrawn file
# goes away; the directories always exist (serve refuses a missing one). A failed sync keeps the previous copy.
for d in calibrations classifiers registry-seed; do
  install -d -m 755 -o 10001 -g 10001 "/srv/data/agent/artifacts/$d"
  aws s3 sync "s3://$BUCKET/core/artifacts/$d/" "/srv/data/agent/artifacts/$d/" --delete --region "$REGION" --only-show-errors ||
    echo "WARNING: could not sync core/artifacts/$d; agent-core keeps the previous copy" >&2
done
chown -R 10001:10001 /srv/data/agent/artifacts
%{ endif ~}
%{ if sync_publication ~}
# tool-service: copy the CURRENT publication of data-pipeline (s3://<bucket>/${publication_prefix}/latest.json -> its run)
# to /srv/data/tools/data/publish, pointer last. Only gold_restricted.duckdb and field_classification.json are copied
# (the core role may read nothing else that matters). A missing publication is a warning: tool-service answers
# data_unavailable until one exists, the rest of the stack still starts.
install -d -m 755 -o 10001 -g 10001 /srv/data/tools /srv/data/tools/data /srv/data/tools/data/publish /srv/data/tools/state /srv/data/tools/current
if aws s3 cp "s3://$BUCKET/${publication_prefix}/latest.json" /srv/data/tools/latest.json.new --region "$REGION" --only-show-errors; then
  RUN_PATH="$(jq -r '.path // empty' /srv/data/tools/latest.json.new)"
  if [[ "$RUN_PATH" =~ ^publish/[A-Za-z0-9._-]+$ ]]; then
    RUN_DIR="/srv/data/tools/data/$RUN_PATH"
    install -d -m 755 -o 10001 -g 10001 "$RUN_DIR"
    for f in gold_restricted.duckdb field_classification.json; do
      [ -s "$RUN_DIR/$f" ] || aws s3 cp "s3://$BUCKET/${publication_prefix}/$${RUN_PATH#publish/}/$f" "$RUN_DIR/$f" --region "$REGION" --only-show-errors
    done
    chown -R 10001:10001 "$RUN_DIR"
    install -m 444 -o 10001 -g 10001 "$RUN_DIR/field_classification.json" /srv/data/tools/current/field_classification.json
    install -m 444 -o 10001 -g 10001 /srv/data/tools/latest.json.new /srv/data/tools/data/publish/latest.json
  else
    echo "WARNING: ${publication_prefix}/latest.json has an unexpected path; tool-service keeps its previous publication" >&2
  fi
  rm -f /srv/data/tools/latest.json.new
else
  echo "WARNING: no publication at s3://$BUCKET/${publication_prefix}/latest.json; tool-service answers data_unavailable" >&2
fi
%{ endif ~}
%{ if install_loader ~}
# Automatic loader (docs/auto-loader.md): script, gate and units come from the bundle; the timer polls engine/inbox/READY.json.
# The loader credentials are never rendered here: the script assumes the loader role itself at run time.
%{ if loader_swap_gb > 0 ~}
# Swap on the data volume (not RAM-backed): a safety net under the docker --memory cap, sized by loader_swap_gb.
if ! swapon --show=NAME --noheadings | grep -q '^/srv/data/swapfile$'; then
  [ -f /srv/data/swapfile ] || { fallocate -l ${loader_swap_gb}G /srv/data/swapfile && chmod 600 /srv/data/swapfile && mkswap /srv/data/swapfile >/dev/null; }
  swapon /srv/data/swapfile || echo "WARNING: could not enable swap" >&2
fi
%{ endif ~}
install -d -m 755 /usr/local/lib/pulso-loader
install -d -m 700 /srv/data/loader /run/pulso/loader
install -m 755 /srv/stack/loader/pulso-loader.sh /usr/local/bin/pulso-loader
install -m 644 /srv/stack/loader/check_cells_k.py /usr/local/lib/pulso-loader/check_cells_k.py
install -m 644 /srv/stack/loader/pulso-loader.service /srv/stack/loader/pulso-loader.timer /srv/stack/loader/pulso-loader-failed.service /etc/systemd/system/
systemctl daemon-reload
systemctl enable --now pulso-loader.timer
%{ endif ~}
%{ if workload != "core" ~}
# Fail closed: the proxy enforces X-Origin-Verify from this value; without it the stack must not start.
grep -q '^ORIGIN_VERIFY=.\+' /run/pulso/env/common.env || { echo "secret key COMMON__ORIGIN_VERIFY is missing or empty" >&2; exit 1; }
%{ endif ~}
