#!/bin/bash
# Non-secret bootstrap. No secret values: they are fetched at start by pulso-stack-prepare.
set -euxo pipefail
dnf install -y docker jq xfsprogs
%{ if cloudwatch ~}
dnf install -y amazon-cloudwatch-agent
%{ endif ~}
install -d /usr/local/lib/docker/cli-plugins
curl -fsSL -o /usr/local/lib/docker/cli-plugins/docker-compose "https://github.com/docker/compose/releases/download/${compose_version}/docker-compose-linux-x86_64"
chmod +x /usr/local/lib/docker/cli-plugins/docker-compose

mkdir -p /etc/docker
cat > /etc/docker/daemon.json <<'JSON'
{"log-driver":"json-file","log-opts":{"max-size":"10m","max-file":"3"}}
JSON
systemctl enable --now docker

# Data volume (stable by-id path on Nitro)
DEV=/dev/disk/by-id/nvme-Amazon_Elastic_Block_Store_${data_volume_id_nodash}
for i in $(seq 1 60); do [ -e "$DEV" ] && break; sleep 2; done
blkid "$DEV" || mkfs.xfs "$DEV"
mkdir -p /srv
UUID=$(blkid -s UUID -o value "$DEV")
grep -q "$UUID" /etc/fstab || echo "UUID=$UUID /srv xfs defaults,nofail 0 2" >> /etc/fstab
mount -a
mkdir -p /srv/stack
%{ if db_volume_id_nodash != "" ~}

# Postgres data volume (own EBS volume, own daily snapshots); the container runs as uid 999
DBDEV=/dev/disk/by-id/nvme-Amazon_Elastic_Block_Store_${db_volume_id_nodash}
for i in $(seq 1 60); do [ -e "$DBDEV" ] && break; sleep 2; done
blkid "$DBDEV" || mkfs.xfs "$DBDEV"
mkdir -p /srv/pgdata
DBUUID=$(blkid -s UUID -o value "$DBDEV")
grep -q "$DBUUID" /etc/fstab || echo "UUID=$DBUUID /srv/pgdata xfs defaults,nofail 0 2" >> /etc/fstab
mount -a
chown 999:999 /srv/pgdata
%{ endif ~}

cat > /usr/local/bin/pulso-stack-prepare <<'PREPARE'
${prepare_script}
PREPARE
chmod 755 /usr/local/bin/pulso-stack-prepare

# pulso-stack-up: containers are RECREATED once per boot, never on a retry.
# /run/pulso is tmpfs, so after a reboot the bind sources of the old containers (env files, key files) are gone and they must be
# recreated: that is the reason for --force-recreate. A failed start (a dependency still unhealthy, a transient S3 or SSM error)
# is retried by systemd every RestartSec; recreating on every retry bounced healthy containers (Postgres every ~45 s, which broke
# platform and engine connections). So: step 1 creates the containers without starting them (--no-start --force-recreate) and
# only then sets the marker /run/pulso/.stack-created (tmpfs: it disappears at reboot, and ExecStopPost removes it on stop);
# step 2 is a plain `up -d`, which starts what is not running and leaves healthy containers alone. To force a recreate by hand:
# `systemctl stop pulso-stack; systemctl start pulso-stack` (deploys use deploy-stack.sh).
cat > /usr/local/bin/pulso-stack-up <<'UP'
#!/bin/bash
set -euo pipefail
MARK="$${STACK_MARK:-/run/pulso/.stack-created}"
if [ ! -e "$MARK" ]; then
  /usr/bin/docker compose -p pulso up --no-start --remove-orphans --force-recreate
  install -d -m 755 "$(dirname "$MARK")"
  : > "$MARK"
fi
exec /usr/bin/docker compose -p pulso up -d --remove-orphans
UP
chmod 755 /usr/local/bin/pulso-stack-up

cat > /etc/systemd/system/pulso-stack.service <<'UNIT'
[Unit]
Description=Pulso hackathon compose stack
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/srv/stack
ExecStartPre=/usr/local/bin/pulso-stack-prepare
ExecStart=/usr/local/bin/pulso-stack-up
ExecStop=/usr/bin/docker compose -p pulso down
ExecStopPost=/bin/rm -f /run/pulso/.stack-created
TimeoutStartSec=600
# A transient S3, SSM, ECR or Secrets Manager error in pulso-stack-prepare must not leave the host up with nothing running.
# The retry never recreates containers (see pulso-stack-up); a long RestartSec keeps a persistent failure from spinning.
Restart=on-failure
RestartSec=60
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
UNIT
systemctl daemon-reload
systemctl enable --now pulso-stack
# Docker does not restart an unhealthy container (restart policies look at exit only): a timer does, for the services named in
# AUTOHEAL_SERVICES (default pulso and agent-core; add others, for example tool-service llm-gateway, in the unit Environment).
# At most AUTOHEAL_MAX_PER_HOUR restarts per service, so a crash loop is left to the deploy rollback and the alarms. Prints no env.
cat > /usr/local/bin/pulso-autoheal <<'AUTOHEAL'
#!/bin/bash
set -uo pipefail
SERVICES="$${AUTOHEAL_SERVICES:-pulso}"
MAX="$${AUTOHEAL_MAX_PER_HOUR:-6}"
STATE=/run/pulso-autoheal
mkdir -p "$STATE"
for svc in $SERVICES; do
  for id in $(docker ps -q --filter label=com.docker.compose.project=pulso --filter label=com.docker.compose.service="$svc" --filter health=unhealthy); do
    now=$(date +%s)
    recent=$(awk -v n="$now" 'n-$1<3600' "$STATE/$svc" 2>/dev/null | wc -l)
    if [ "$recent" -ge "$MAX" ]; then echo "autoheal: $svc restarted $recent times in the last hour, leaving it"; continue; fi
    echo "$now" >> "$STATE/$svc"
    echo "autoheal: restarting $svc (health=unhealthy)"
    docker restart "$id" >/dev/null
  done
done
AUTOHEAL
chmod 755 /usr/local/bin/pulso-autoheal
cat > /etc/systemd/system/pulso-autoheal.service <<'UNIT'
[Unit]
Description=Restart unhealthy Pulso containers
After=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/pulso-autoheal
UNIT
cat > /etc/systemd/system/pulso-autoheal.timer <<'UNIT'
[Unit]
Description=Pulso autoheal every minute

[Timer]
OnBootSec=5min
OnUnitActiveSec=60s

[Install]
WantedBy=timers.target
UNIT
systemctl daemon-reload
systemctl enable --now pulso-autoheal.timer
%{ if cloudwatch ~}
cat > /opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json <<'CW'
{"logs":{"logs_collected":{"files":{"collect_list":[{"file_path":"/var/lib/docker/containers/*/*-json.log","log_group_name":"${log_group}","log_stream_name":"{instance_id}"}]}}}}
CW
/opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl -a fetch-config -m ec2 -s -c file:/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json
%{ endif ~}
